# SFF Taxi production settings. Copy to deploy/.env.prod on the server, fill in, chmod 600.
# Never commit .env.prod; keep an encrypted copy in the password manager.
#
# [required] must be set; [optional] may stay empty ("KEY=" means "not set").
# No inline comments after values, no quotes, no "$" in values (docker compose parses this file).
# deploy/gen-secrets.sh prints fresh values for every secret below: paste each over its empty
# line (or generate one at a time with the command shown next to it).

# --- Images and optional parts ------------------------------------------------------------
# [required] images built by .github/workflows/images.yml (or docker build, docs/deploy.md)
TAXI_API_IMAGE=ghcr.io/OWNER/sff-taxi-api:REPLACE_WITH_TAG
TAXI_WEB_IMAGE=ghcr.io/OWNER/sff-taxi-web:REPLACE_WITH_TAG
# [optional] comma-separated compose profiles: seaweedfs, osrm, monitoring
COMPOSE_PROFILES=seaweedfs
# [optional] API instances behind Caddy (default 1; 2 for rolling restarts without errors)
API_REPLICAS=2

# --- Domains and TLS --------------------------------------------------------------------
# [required] point A records at the server before the first start
API_DOMAIN=api.example.uz
PANEL_DOMAIN=panel.example.uz
# [optional] only with the seaweedfs profile (driver documents and photos)
FILES_DOMAIN=files.example.uz
# [optional] the panel's origin for CORS (default https://PANEL_DOMAIN)
PANEL_ORIGIN=
# [required] Let's Encrypt account e-mail (expiry warnings)
ACME_EMAIL=ops@example.uz
# [optional] host ports of Caddy; keep 80/443 in production
HTTP_PORT=80
HTTPS_PORT=443

# --- Database and Redis (hex only: they are embedded in URLs) -----------------------------
# [required] openssl rand -hex 32. The owner runs migrations only; it never reaches the app.
POSTGRES_OWNER_PASSWORD=
# [required] openssl rand -hex 32. Runtime role taxi_app (DATABASE_URL is built from it).
POSTGRES_APP_PASSWORD=
# [required] openssl rand -hex 32
REDIS_PASSWORD=
# [optional] connections per API/worker process and timeouts (docs/audit.md)
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- API core ----------------------------------------------------------------------------
LOG_LEVEL=info
# [required] openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# [required] operators: +998XXXXXXXXX, comma-separated
ADMIN_PHONES=
# [optional] public origin of the share-trip page links sent to riders' contacts
SHARE_BASE_URL=https://api.example.uz

# --- SMS sign-in codes (console is refused in production) ---------------------------------
# [required] eskiz or playmobile
SMS_PROVIDER=eskiz
# [optional] must match the template approved by the provider
SMS_OTP_TEMPLATE=SFF Taxi: tasdiqlash kodi {code}. Kodni hech kimga bermang.
# [required for eskiz]
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# [required for playmobile]
PLAYMOBILE_BASE_URL=
PLAYMOBILE_USERNAME=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_ORIGINATOR=3700
# [optional] store reviewers who cannot receive SMS: +998XXXXXXXXX:123456 pairs
OTP_FIXED_CODES=
# [optional] SMS to riders whose rides operators booked by phone
NOTIFY_SMS_PHONE_ORDERS=true

# --- Card payments: prepaid rides and driver top-ups (a method is offered once set) ---------
# Payme merchant cabinet: callback URL https://API_DOMAIN/v1/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=false
# Click merchant cabinet: prepare/complete URLs https://API_DOMAIN/v1/payments/click/prepare|complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
# [optional] where the checkout returns the customer ({intentId} is replaced): per purpose
# (rider app for ride payments, driver app for top-ups), else the shared one
PAYMENT_RETURN_URL_RIDE=
PAYMENT_RETURN_URL_TOPUP=
PAYMENT_RETURN_URL=

# --- Tax receipts and licence registry (docs/fiscal-and-licence.md) ------------------------
# none until the OFD contract is signed; manual = operators verify licence cards by hand
FISCAL_PROVIDER=none
LICENCE_REGISTRY=manual

# --- Geography (copied from SFF Eats: cities, geocoding, road distances) --------------------
# yandex, nominatim or none
GEOCODER=yandex
YANDEX_GEOCODER_KEY=
GEOCODER_CONTACT_EMAIL=
# osrm (profile osrm, OSRM_URL=http://osrm:5000) or none
ROUTER=none
OSRM_URL=
ROUTER_DETOUR_FACTOR=1.35
YANDEX_MAPS_JS_KEY=
# [optional] own tile server for the panel and apps (tile.openstreetmap.org is for tests only)
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# --- Notifications ------------------------------------------------------------------------
PUSH_PROVIDER=expo
# [optional] only when Enhanced push security is on for the Expo project
EXPO_ACCESS_TOKEN=

# --- Driver documents and photos (private bucket; all of bucket and keys, or none) --------
# With the seaweedfs profile keep the endpoint below; the keys are created from these values.
STORAGE_S3_ENDPOINT=http://seaweedfs:8333
STORAGE_S3_PUBLIC_ENDPOINT=https://files.example.uz
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=sff-taxi
# openssl rand -hex 16 / openssl rand -hex 32
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- App configuration (GET /v1/config, /v1/driver/config) --------------------------------
# [optional] operator phone (E.164), Telegram username (without @) and office address
SUPPORT_PHONE=
SUPPORT_TELEGRAM=
OFFICE_ADDRESS=
# [optional] oldest app versions (x.y.z) still allowed; older ones show "update".
# Empty = no forced update: set only after the new build is live in the stores.
MIN_RIDER_APP_VERSION=
MIN_DRIVER_APP_VERSION=
# [optional] store pages the update screens open
STORE_URL_ANDROID_RIDER=
STORE_URL_IOS_RIDER=
STORE_URL_ANDROID_DRIVER=
STORE_URL_IOS_DRIVER=

# --- Observability ------------------------------------------------------------------------
# [required] openssl rand -hex 24; the API refuses to start in production without it
METRICS_TOKEN=
# [optional] Sentry project DSN (errors only, no personal data)
SENTRY_DSN=
# [optional] Grafana admin password (profile monitoring): openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# --- Backups (deploy/backup.sh) -----------------------------------------------------------
BACKUP_RETENTION_DAYS=14
# [optional, strongly advised] rclone remote:path for the off-site copy. Dumps hold personal
# data: the target must also be in Uzbekistan and should be an rclone "crypt" remote.
BACKUP_RCLONE_REMOTE=
BACKUP_REMOTE_RETENTION_DAYS=60
# [optional] with the seaweedfs profile: also archive the file store (driver documents)
BACKUP_FILES=true
# [optional] pinged after each successful backup (dead-man switch)
BACKUP_PING_URL=
