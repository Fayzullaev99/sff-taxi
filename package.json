{
  "name": "sff-taxi",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "dev": "npm run start:dev -w apps/api",
    "dev:worker": "npm run start:worker:dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "docker:build": "docker build -t sff-taxi-api:local . && docker build -f Dockerfile.web -t sff-taxi-web:local ."
  },
  "overrides": {
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
