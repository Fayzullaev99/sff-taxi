# Landing site settings, compiled into the bundle at build time (Vite reads VITE_*).
# Every value has a placeholder default (src/config.ts): the site builds without this file.
# Copy to .env (development) or pass as docker build args (Dockerfile.landing).

# Public origin of the site: canonical URLs, Open Graph image, sitemap
VITE_SITE_URL=https://taxi.sff.uz
# API origin. Empty = same origin (/v1/* is proxied by the edge Caddy, see deploy/Caddyfile)
VITE_API_URL=

# Store pages. The App Store links may stay empty until the iOS builds are published:
# the buttons then say "Tez kunda" instead of leading nowhere.
VITE_PLAY_RIDER=https://play.google.com/store/apps/details?id=uz.sff.taxi
VITE_APPSTORE_RIDER=
VITE_PLAY_DRIVER=https://play.google.com/store/apps/details?id=uz.sff.taxi.driver
VITE_APPSTORE_DRIVER=
VITE_ANDROID_PACKAGE=uz.sff.taxi
VITE_ANDROID_DRIVER_PACKAGE=uz.sff.taxi.driver

# Dispatch office: E.164 phone (shown formatted; the placeholder hides the call buttons),
# Telegram username without @, street address for drivers
VITE_SUPPORT_PHONE=+998XXXXXXXXX
VITE_SUPPORT_TELEGRAM=
VITE_OFFICE_ADDRESS=Guliston sh., [ko‘cha, uy]

# Legal entity for the footer, the privacy policy and the terms
VITE_LEGAL_NAME=[«SFF TAXI» MChJ]
VITE_INN=[XXX XXX XXX]
VITE_LEGAL_EMAIL=info@sff.uz

# The launch promo code advertised on the page (created by apps/api/scripts/launch-campaign.ts)
VITE_LAUNCH_PROMO_CODE=GULISTON

# Analytics: empty = nothing is loaded or sent. A Plausible script URL with
# VITE_ANALYTICS_SITE=taxi.sff.uz, or the Yandex Metrika loader with the counter id.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_SITE=

# Share-trip map tiles (tile.openstreetmap.org is for low traffic only; MAP_TILE_URL of the API)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
