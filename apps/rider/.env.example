# API base URL. 10.0.2.2 is the host machine as seen from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3200
# The dispatch office's phone number (shown when no driver was found, in settings and SOS).
# Leave empty to hide the "call the operator" buttons.
EXPO_PUBLIC_OPERATOR_PHONE=
# Optional: needed for maps in standalone Android/iOS builds (Expo Go works without it).
GOOGLE_MAPS_API_KEY=
# Push notifications: the EAS project id from `eas init`.
# Without it the app works and simply registers no push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Path to google-services.json (Firebase, FCM) for Android builds; optional in development.
GOOGLE_SERVICES_JSON=
