{
  "name": "@sff-taxi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker --exec \"node --env-file-if-exists=.env\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/core/db/migrate.cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@sentry/node": "^11.0.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
