NODE_ENV=development
PORT=3200
LOG_LEVEL=info

# Runtime connection: the non-owner role.
DATABASE_URL=postgres://taxi_app:taxi_app_dev@localhost:5460/taxi
# Migrations only: the schema owner.
DATABASE_MIGRATION_URL=postgres://taxi_owner:taxi_owner_dev@localhost:5460/taxi
REDIS_URL=redis://localhost:6394/0

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Phones that become platform operators (dispatchers) on sign-in, comma-separated
ADMIN_PHONES=

# console (dev: codes are logged), eskiz or playmobile
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# App-store reviewers: +998XXXXXXXXX:123456 pairs that sign in without SMS
OTP_FIXED_CODES=

# Operator web panel origin(s)
CORS_ORIGINS=http://localhost:5280

# Uploads: driver documents and photos in a PRIVATE S3-compatible bucket (local SeaweedFS:
# docker compose up -d s3). Unset = uploads answer 503.
STORAGE_S3_ENDPOINT=http://localhost:8335
STORAGE_S3_BUCKET=sff-taxi-dev
STORAGE_S3_ACCESS_KEY=taxi_dev_access
STORAGE_S3_SECRET_KEY=taxi_dev_secret_0123456789
# Endpoint the apps reach, when it differs from the API's (e.g. a phone on the LAN)
STORAGE_S3_PUBLIC_ENDPOINT=

# Geography. Address search: yandex, nominatim or none
GEOCODER=none
YANDEX_GEOCODER_KEY=
# Nominatim usage policy contact; also makes Nominatim Yandex's fallback
GEOCODER_CONTACT_EMAIL=
# Road distances for fares and driver ETAs: osrm (self-hosted, OSRM_URL) or none
# (straight line x ROUTER_DETOUR_FACTOR)
ROUTER=none
OSRM_URL=
ROUTER_DETOUR_FACTOR=1.35
# Yandex Maps JS/MapKit key for the apps; without it they use OSM tiles
YANDEX_MAPS_JS_KEY=

# Worker: health/metrics port and how often the dispatcher runs
WORKER_HTTP_PORT=3201
DISPATCH_TICK_MS=1000

# Legal integrations (docs/fiscal-and-licence.md): fiscal receipts are prepared and kept
# until an OFD provider is connected; licence cards are checked by operators by hand
FISCAL_PROVIDER=none
LICENCE_REGISTRY=manual

# What the apps show (GET /v1/config): support line, Telegram, the office for cash top-ups
SUPPORT_PHONE=
SUPPORT_TELEGRAM=
OFFICE_ADDRESS=
# Older app versions are asked to update; empty = no forced update (the default)
MIN_RIDER_APP_VERSION=
MIN_DRIVER_APP_VERSION=
# Store pages the update screens open (optional)
STORE_URL_ANDROID_RIDER=
STORE_URL_IOS_RIDER=
STORE_URL_ANDROID_DRIVER=
STORE_URL_IOS_DRIVER=

# Share-trip links: {SHARE_BASE_URL}/t/{token}
SHARE_BASE_URL=https://taxi.sff.uz

# Push: expo (Expo push service) or console (log only). Default: expo in production, console otherwise
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
# SMS with car/plate/arrival to riders who ordered by phone (costs money)
NOTIFY_SMS_PHONE_ORDERS=true

# Card payments (docs/payments.md): card rides prepaid before dispatch, driver top-ups
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
# Payme sandbox checkout (checkout.test.paycom.uz)
PAYME_TEST=false
# Where the payment page sends the payer back; {intentId} is replaced. Per purpose first
# (ride payments: the rider app; top-ups: the driver app), then the shared one
PAYMENT_RETURN_URL_RIDE=sfftaxi://payments/{intentId}
PAYMENT_RETURN_URL_TOPUP=sff-taxi-driver://topup?id={intentId}
PAYMENT_RETURN_URL=

# Observability
METRICS_TOKEN=
SENTRY_DSN=

# Database timeouts (ms; 0 = none)
DB_CONNECT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
