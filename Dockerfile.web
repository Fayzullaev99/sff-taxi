# syntax=docker/dockerfile:1
# Static build of the operator (dispatcher) panel, served by Caddy as a non-root user.
#   docker build -f Dockerfile.web -t sff-taxi-web .
# VITE_API_URL is compiled into the bundle. Leave it empty (the default): the panel then calls
# its own origin (/v1/...), which the edge Caddy proxies to the API, so one image fits every
# environment and no CORS is needed. Set it only to serve the panel without that proxy.

FROM node:24-bookworm-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
# every workspace's manifest: a partial install hoists shared packages (React types) differently
# from the monorepo, and the panel would type-check against other versions than in CI
COPY apps/api/package.json apps/api/
COPY apps/rider/package.json apps/rider/
COPY apps/driver/package.json apps/driver/
COPY apps/web/package.json apps/web/
# no install scripts: the mobile apps' native postinstall steps are not needed for the panel
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts --no-audit --no-fund
COPY apps/web apps/web
ARG VITE_API_URL=""
# the build script type-checks first (tsc --noEmit && vite build)
RUN VITE_API_URL=$VITE_API_URL npm run build -w apps/web

FROM caddy:2-alpine
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data
COPY --from=build /repo/apps/web/dist /srv
COPY deploy/web.Caddyfile /etc/caddy/Caddyfile
RUN chown -R 1000:1000 /config /data
USER 1000:1000
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
